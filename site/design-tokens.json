      "atlas-instruction": "var(--cl-atlas-instruction)",
      "atlas-thread": "var(--cl-atlas-thread)",
      "atlas-node-line": "var(--cl-atlas-node-line)",
      "atlas-node-detail": "var(--cl-atlas-node-detail)",
      "modal-scrim": "var(--cl-modal-scrim)",
      "type-display": "var(--cl-font-display)",
      "type-reading": "var(--cl-font-reading)",
      "type-code": "var(--cl-font-mono)",
      "type-body-size": "var(--cl-type-body)",
      "type-body-leading": "var(--cl-leading-body)",
      "type-reading-leading": "var(--cl-leading-reading)"
    },
    "component": {
      "control-min-size": "var(--cl-control)",
      "control-border": "var(--line-strong)",
      "control-focus": "var(--focus)",
      "panel-background": "var(--surface-raised)",
      "panel-background-soft": "var(--surface-soft)",
      "panel-border": "var(--line-strong)",
      "panel-radius": "var(--cl-radius-md)",
      "panel-shadow": "5px 5px 0 var(--shadow-color)",
      "atlas-node-rest": "var(--surface-panel)",
      "atlas-node-hover": "var(--warning)",
      "atlas-node-active": "var(--signal)",
      "atlas-thread-rest": "var(--cl-line)",
      "atlas-thread-active": "var(--signal)",
      "reading-measure": "var(--cl-measure-reading)",
      "reading-leading": "var(--type-reading-leading)",
      "reading-font": "var(--type-reading)"
    },
    "compatibility": {
      "canvas": "var(--cl-canvas)",
      "ink": "var(--cl-ink)",
      "ink-soft": "var(--cl-ink-soft)",
      "paper": "var(--cl-paper)",
      "paper-blue": "var(--cl-paper-blue)",
      "paper-coral": "var(--cl-paper-coral)",
      "paper-yellow": "var(--cl-paper-yellow)",
      "muted": "var(--cl-muted)",
      "line": "var(--cl-line)",
      "acid": "var(--cl-mint)",
      "acid-ink": "var(--cl-mint-dark)",
      "display": "var(--type-display)",
      "mono": "var(--type-code)",
      "radius": "var(--cl-radius-md)"
    }
