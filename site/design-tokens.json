  "modes": {
    "compact": {
      "query": "(max-width: 820px)",
      "tokens": {
        "cl-header": "64px",
        "cl-radius-md": "14px",
        "cl-radius-lg": "20px"
      }
    },
    "high-contrast": {
      "query": "(prefers-contrast: more)",
      "tokens": {
        "line-quiet": "var(--cl-line)",
        "line-strong": "var(--cl-ink)",
        "text-muted": "var(--cl-ink)"
      }
    }
  }
