{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordloom.dev/schemas/v0.1/binding.schema.json",
  "title": "Concord Loom content-addressed binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "framework_version",
    "created_at",
    "binding_digest",
    "digest_contract",
    "active_root_loop_ids",
    "artifacts",
    "accepted_by"
  ],
  "properties": {
    "kind": {
      "const": "concordloom.binding"
    },
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "framework_version": {
      "const": "0.1.0"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "binding_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "excluded_fields"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "rfc8785"
        },
        "excluded_fields": {
          "const": [
            "/binding_digest"
          ]
        }
      }
    },
    "active_root_loop_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
        "minItems": 6,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "accepted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "actor",
        "authority_ref",
        "accepted_at",
        "proposal_digest",
        "rationale"
      ],
      "properties": {
        "decision_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "actor": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "accepted_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "proposal_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predecessor_binding_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "digest"
      ],
      "properties": {
        "role": {
          "enum": [
            "accepted_project_graph",
            "decision_log",
            "loop_design_proposal",
            "accepted_loop_design",
            "cycle_registry",
            "policy",
            "evolution_history",
            "atlas_input"
          ]
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  }
}
