{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordloom.dev/schemas/v0.1/catalog.schema.json",
  "title": "Concord Loom append-only binding catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "active_binding_digest", "entries"],
  "properties": {
    "kind": {"const": "concordloom.catalog"},
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "active_binding_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "binding_digest",
        "path",
        "activated_by_decision_digest"
      ],
      "properties": {
        "binding_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "binding_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "previous_binding_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "activated_by_decision_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  }
}

