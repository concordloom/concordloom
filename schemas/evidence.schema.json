{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordloom.dev/schemas/v0.1/evidence.schema.json",
  "title": "Concord Loom evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "run_id",
    "node_id",
    "loop_id",
    "contract_id",
    "attempt_id",
    "binding_digest",
    "policy_digest",
    "candidate",
    "producer",
    "effective_route",
    "started_at",
    "finished_at",
    "result",
    "claims",
    "provenance",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "concordloom.evidence"
    },
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "node_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "loop_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "contract_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "binding_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "policy_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "producer": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "effective_route": {
      "$ref": "#/$defs/effectiveRoute"
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "indeterminate"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/provenance"
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree_digest",
        "manifest_digest",
        "artifact_digests"
      ],
      "properties": {
        "tree_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "uniqueItems": true
        }
      }
    },
    "effectiveRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "agent",
        "model",
        "reasoning",
        "skill",
        "subagents",
        "tools",
        "data_egress"
      ],
      "properties": {
        "principal_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_provider": {
          "type": "string"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versionedComponent"
          },
          "uniqueItems": true
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versionedComponent"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRef"
          },
          "uniqueItems": true
        },
        "tool_capabilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "subagent_identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subagentIdentity"
          },
          "uniqueItems": true
        },
        "data_egress": {
          "$ref": "#/$defs/dataEgress"
        }
      }
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ref",
        "digest",
        "access_mode"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "repository_path",
            "artifact",
            "mcp_resource"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "access_mode": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        }
      }
    },
    "subagentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "principal_id",
        "agent",
        "model_provider",
        "model"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "principal_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model_provider": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataEgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "path_prefixes",
        "content_classes"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "content_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "result"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ]
        },
        "measurement": true
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "digest"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  }
}
