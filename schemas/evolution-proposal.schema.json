{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordloom.dev/schemas/v0.1/evolution-proposal.schema.json",
  "title": "Concord Loom bounded evolution proposal",
  "description": "A proposal-only artifact. It cannot activate itself or replace the currently accepted binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "status",
    "base_binding_digest",
    "generated_at",
    "proposed_by",
    "signals",
    "operations",
    "expected_effect",
    "risk",
    "decision_required",
    "decision_authority_ref",
    "activation_allowed"
  ],
  "properties": {
    "kind": {
      "const": "concordloom.evolution-proposal"
    },
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "status": {
      "const": "proposed"
    },
    "base_binding_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "proposed_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "signals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "evolution-signal.schema.json"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/graphOperation"
      }
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "failure_modes",
        "rollback"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_required": {
      "const": true
    },
    "decision_authority_ref": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "activation_allowed": {
      "const": false
    }
  }
}
