        "tools/check_docs.py",
        "tools/check_language.py",
        "tools/check_site.py"
      ]
    },
    "local_first": true,
    "model_policy": {
      "allowed_content_classes": [
        "metadata",
        "history",
        "source",
        "tests",
        "documentation",
        "configuration",
        "evidence"
      ],
      "allowed_models": [
        {
          "model": "none",
          "provider": ""
        },
        {
          "model": "gpt-5.6-luna",
          "provider": "openai"
        },
        {
          "model": "gpt-5.6-terra",
          "provider": "openai"
        },
        {
          "model": "gpt-5.6-sol",
          "provider": "openai"
        }
      ],
      "allowed_path_prefixes": [
        "."
      ],
      "allowed_providers": [
        "openai"
      ],
      "max_cost_units": 10,
      "privacy": "public_data_only",
      "public_content_classes": [
        "metadata",
        "history",
        "source",
        "tests",
        "documentation",
        "configuration",
        "evidence"
      ],
      "record_effective_model": true
    }
  },
  "id": "concordloom-self-policy-v9",
  "kind": "concordloom.policy",
  "routing": {
    "operator_selects_outcomes": true,
    "orchestrator_selects_machinery": true,
    "record_effective_route": true,
    "record_planned_route": true
  },
  "schema_version": "0.1"
}
