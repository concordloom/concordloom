{
  "authority": {
    "principals": [
      {
        "id": "example-operator",
        "kind": "human",
        "roles": [
          "operator"
        ]
      },
      {
        "id": "example-orchestrator",
        "kind": "agent",
        "roles": [
          "orchestrator"
        ]
      },
      {
        "id": "example-executor",
        "kind": "agent",
        "roles": [
          "executor"
        ]
      },
      {
        "id": "example-reviewer",
        "kind": "agent",
        "roles": [
          "reviewer"
        ]
      },
      {
        "id": "example-publisher",
        "kind": "automation",
        "roles": [
          "publisher"
        ]
      }
    ],
    "roles": [
      {
        "capabilities": [
          "accept-frontend-concept",
          "accept-intent",
          "accept-loop-design",
          "accept-source-publication",
          "activate-binding",
          "authorize-run",
          "decide-evolution",
          "escalate"
        ],
        "description": "Accepts intent, loop design, evolution, and bindings.",
        "id": "operator"
      },
      {
        "capabilities": [
          "route-run",
          "accept-parent",
          "escalate"
        ],
        "description": "Routes accepted outcomes without changing their authority.",
        "id": "orchestrator"
      },
      {
        "capabilities": [
          "execute-work",
          "produce-evidence",
          "escalate"
        ],
        "description": "Produces scoped candidates and factual evidence.",
        "id": "executor"
      },
      {
        "capabilities": [
          "review-candidate",
          "accept-gate",
          "produce-evidence",
          "escalate"
        ],
        "description": "Independently evaluates a pinned candidate.",
        "id": "reviewer"
      },
      {
        "capabilities": [
          "execute-work",
          "publish-release",
          "produce-evidence",
          "escalate"
        ],
        "description": "Performs one explicitly authorized external effect.",
        "id": "publisher"
      }
    ],
    "separation_rules": [
      {
        "applies_to_loop_ids": [
          "assure-release",
          "critique-frontend-experience",
          "design-site-experience",
          "review-candidate",
          "review-comprehension",
          "review-successor",
          "verify-frontend-candidate"
        ],
        "disallow_same_principal": true,
        "id": "author-verification-separation",
        "review_capability": "review-candidate",
        "subject_capability": "execute-work"
      },
      {
        "applies_to_loop_ids": [
          "accept-frontend-concept"
        ],
        "disallow_same_principal": true,
        "id": "frontend-concept-author-acceptance-separation",
        "review_capability": "accept-frontend-concept",
        "subject_capability": "execute-work"
      }
    ]
  },
  "evidence": {
    "accepted_results": [
      "pass",
      "fail",
      "indeterminate"
    ],
    "child_receipts_auto_accept_parent": false,
    "content_addressed": true,
    "require_candidate_digest": true,
    "require_policy_digest": true
  },
  "evolution": {
    "activation_capability": "activate-binding",
    "allow_self_activation": false,
    "decision_capability": "decide-evolution",
    "governance_source": "proposal.base_binding_digest",
    "minimum_repeated_signals": 2,
    "proposal_capability": "route-run"
  },
  "execution": {
    "allowed_tools": [
      "git",
      "github",
      "imagegen",
      "orca",
      "python",
      "web"
    ],
    "control_plane": {
      "actions": [
        "new",
        "authorize",
        "record-attempt",
        "record-evidence",
        "complete"
      ],
      "candidate_write": false,
      "runner_principal_id": "example-orchestrator",
      "state_path": ".concord"
    },
    "default_budgets": {
      "max_attempts": 3,
      "max_cost_units": 10,
      "max_elapsed_seconds": 3600,
      "on_exhaustion": "failed"
    },
    "default_scope": {
      "external_mutations": [
        "github-organization-profile",
        "github-pages",
        "github-pull-request",
        "github-pull-request-merge",
        "github-release-assets",
        "github-repository-homepage",
        "github-repository-security-settings",
        "github-repository-social-preview",
        "github-repository-source",
        "github-version-tag"
      ],
      "network": "write",
      "read_paths": [
        ".agents",
        ".concord/research",
        ".concord/runs",
        ".github",
        ".github/dependabot.yml",
        ".github/workflows",
        ".github/workflows/frontend.yml",
