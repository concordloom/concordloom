        "tools/check.sh",
        "tools/check_docs.py",
        "tools/check_language.py",
        "tools/check_site.py"
      ],
      "write_paths": [
        ".agents",
        ".concord/research",
        ".github/dependabot.yml",
        ".github/workflows",
        ".github/workflows/frontend.yml",
        ".gitignore",
        "AGENTS.md",
