      "horizontal mobile graph",
      "one-off Atlas styling",
      "random decorative node glyph",
      "raw color outside token source",
      "tiny scaled desktop labels"
    ],
    "material": "warm canvas with tactile paper modules and black ink boundaries",
    "name": "Signal Canvas",
    "personality": [
      "serious",
      "informal",
      "tactile",
      "confident",
      "startup devtool"
