{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordloom.dev/bootstrap/v0.1/cycle.schema.json",
  "title": "Concord Loom bootstrap release cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "title",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "depends_on",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "mode": {
            "enum": [
              "write",
              "read_only"
            ]
          },
          "independent": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
